# Runtime exclusivo do exportador Salesforce. Nunca versionar valores reais.
# O Chrome deve usar perfil dedicado, estar autenticado manualmente por MFA e
# expor CDP somente no loopback da mesma máquina que executa o exportador.
SALESFORCE_CDP_URL=http://127.0.0.1:9222

# Arquivo local protegido que recebe payload e diagnósticos. O processo precisa
# conseguir criar o diretório e grava o arquivo final por troca atômica 0600.
SALESFORCE_CANDIDATE_OUTPUT=/var/lib/descomplica-salesforce/candidate.json

# Opcional para reprocessar uma competência em ensaio controlado. Ausente usa a
# data corrente em America/Sao_Paulo.
SALESFORCE_REFERENCE_DATE=
