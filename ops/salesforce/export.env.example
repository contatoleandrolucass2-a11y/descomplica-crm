# Runtime exclusivo do exportador Salesforce. Nunca versionar valores reais.
# `pnpm salesforce:chrome` inicia uma janela visível com perfil exclusivo e CDP
# somente no loopback da mesma máquina do exportador. Concluir login/MFA nessa
# janela. Overrides opcionais devem ser caminhos absolutos.
SALESFORCE_CDP_PORT=9222
SALESFORCE_CDP_URL=http://127.0.0.1:9222
# SALESFORCE_CHROME_EXECUTABLE=/caminho/absoluto/para/google-chrome
# SALESFORCE_CHROME_PROFILE=/caminho/absoluto/para/perfil-dedicado

# Copiar este arquivo para `ops/salesforce/.env` (ignorado pelo Git). Os quatro
# comandos Salesforce carregam esse mesmo arquivo automaticamente.
#
# Arquivo local protegido que recebe payload e diagnósticos. O diretorio pai
# deve existir e pertencer ao operador. Use caminho absoluto nativo; no Windows,
# prefira uma pasta exclusiva dentro de %LOCALAPPDATA%. POSIX recebe modo 0600;
# Windows recebe ACL exclusiva do usuario atual.
SALESFORCE_CANDIDATE_OUTPUT=/home/operador/.local/state/descomplica-crm/salesforce/candidate.json

# O envio permanece desligado ate o workflow n8n ter autenticacao, validacao
# completa, destino CRM e releitura aprovados via MCP. O segredo e exclusivo da
# origem -> n8n, fica em arquivo privado (0600 no POSIX; ACL owner-only no
# Windows) e nunca e o Bearer n8n -> CRM.
SALESFORCE_N8N_PUBLISH_ENABLED=false
SALESFORCE_N8N_WEBHOOK_URL=
SALESFORCE_N8N_SECRET_FILE=/var/lib/descomplica-salesforce/n8n-source-bearer

# Opcional para reprocessar uma competência em ensaio controlado. Ausente usa a
# data corrente em America/Sao_Paulo.
SALESFORCE_REFERENCE_DATE=
