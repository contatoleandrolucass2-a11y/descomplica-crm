server {
    listen 80;
    listen [::]:80;
    server_name homolog.descomplicapro.com.br;

    access_log /var/log/nginx/homolog.descomplicapro.com.br.access.log;
    error_log /var/log/nginx/homolog.descomplicapro.com.br.error.log;
    server_tokens off;

    add_header X-Robots-Tag "noindex, nofollow, noarchive" always;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type text/plain;
        try_files $uri =404;
    }

    # Password-recovery codes must never enter access logs.
    location = /auth/callback {
        access_log off;
        error_log /dev/null crit;
        return 301 https://$host$request_uri;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name homolog.descomplicapro.com.br;

    access_log /var/log/nginx/homolog.descomplicapro.com.br.access.log;
    error_log /var/log/nginx/homolog.descomplicapro.com.br.error.log;

    ssl_certificate /etc/letsencrypt/live/homolog.descomplicapro.com.br/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/homolog.descomplicapro.com.br/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_timeout 1d;
    ssl_session_cache shared:HOMOLOG_SSL:10m;
    ssl_session_tickets off;

    auth_basic "Descomplica CRM - Homologacao";
    auth_basic_user_file /etc/nginx/.htpasswd-descomplica-homologation;

    client_max_body_size 1m;
    server_tokens off;

    add_header X-Robots-Tag "noindex, nofollow, noarchive" always;

    location = /robots.txt {
        default_type text/plain;
        try_files /homologation-robots-file-does-not-exist @homologation_robots;
    }

    location @homologation_robots {
        default_type text/plain;
        return 200 "User-agent: *\nDisallow: /\n";
    }

    # Keep one-time recovery token hashes out of Nginx logs while preserving
    # the application callback. Verification reaches Auth only by POST/body.
    location = /auth/callback {
        access_log off;
        error_log /dev/null crit;
        proxy_pass http://127.0.0.1:3100;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Port 443;
        proxy_set_header Authorization "";
        proxy_set_header Connection "";
        proxy_buffer_size 8k;
        proxy_buffers 8 8k;
        proxy_busy_buffers_size 16k;
        proxy_buffering off;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
    }

    location / {
        proxy_pass http://127.0.0.1:3100;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Port 443;
        proxy_set_header Authorization "";
        proxy_set_header Connection "";
        proxy_buffer_size 8k;
        proxy_buffers 8 8k;
        proxy_busy_buffers_size 16k;
        proxy_buffering off;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
    }
}
