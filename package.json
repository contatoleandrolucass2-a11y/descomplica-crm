{
  "name": "descomplica-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && node --test ops/salesforce/*.node-test.mjs",
    "test:watch": "vitest",
    "qa:browser:install": "playwright install chromium",
    "qa:visual:reference": "node scripts/qa/reference-parity.mjs reference",
    "qa:visual:authenticated": "node scripts/qa/local-authenticated-visual.mjs",
    "qa:e2e:release": "QA_RELEASE_BROWSER=true node scripts/qa/local-rls-api.mjs",
    "qa:security:anonymous": "node scripts/qa/reference-parity.mjs boundary",
    "qa:security:rls-api": "node scripts/qa/local-rls-api.mjs",
    "homologation:prepare": "node scripts/homologation/prepare-runtime.mjs",
    "homologation:fixtures": "node scripts/homologation/provision-visual.mjs",
    "homologation:dns": "node scripts/homologation/configure-dns.mjs",
    "homologation:migrate:auth-mfa": "node scripts/homologation/apply-auth-mfa-migrations.mjs",
    "homologation:backup:legacy-canary-retirement": "node scripts/homologation/create-legacy-canary-retirement-backup.mjs",
    "homologation:migrate:legacy-canary-retirement": "node scripts/homologation/apply-legacy-canary-retirement.mjs",
    "homologation:configure:legacy-canary-retirement": "node scripts/homologation/configure-legacy-migration-runtime.mjs",
    "homologation:bind-runtime-release": "node scripts/homologation/bind-runtime-release.mjs",
    "homologation:qa": "node scripts/homologation/run-remote-qa.mjs",
    "mapping:reconcile": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON ops/mappings/import.ts",
    "salesforce:chrome": "node --env-file-if-exists=ops/salesforce/.env ops/salesforce/launch-dedicated-chrome.mjs",
    "salesforce:export": "node --env-file-if-exists=ops/salesforce/.env ops/salesforce/export-candidate.mjs",
    "salesforce:publish": "node --env-file-if-exists=ops/salesforce/.env ops/salesforce/publish-candidate.mjs",
    "salesforce:export:watch": "node --env-file-if-exists=ops/salesforce/.env ops/salesforce/run-every-30-minutes.mjs",
    "commercial-policy:verify": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON ops/commercial-policies/verify.ts",
    "access:master": "node ops/access/provision-master.mjs",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "knowledge:install": "node scripts/knowledge/obsidian.mjs install",
    "knowledge:sync": "node scripts/knowledge/obsidian.mjs sync",
    "knowledge:context": "node scripts/knowledge/obsidian.mjs context",
    "knowledge:search": "node scripts/knowledge/obsidian.mjs search",
    "resources:check": "node scripts/knowledge/resources.mjs",
    "resources:doctor": "node scripts/knowledge/doctor.mjs",
    "devtools:next": "node scripts/knowledge/devtools.mjs next",
    "devtools:chrome": "node scripts/knowledge/devtools.mjs chrome",
    "devtools:check": "node scripts/knowledge/devtools-check.mjs",
    "knowledge:status": "node scripts/knowledge/obsidian.mjs status",
    "audit": "pnpm audit --audit-level high",
    "security:secrets": "gitleaks dir . --redact=100 --no-banner",
    "security:secrets:history": "gitleaks git . --redact=100 --no-banner",
    "security:osv": "osv-scanner scan source --lockfile pnpm-lock.yaml .",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:rehearse": "node scripts/release/isolated-restore-rehearsal.mjs",
    "db:test": "supabase test db",
    "image:build": "node scripts/release/build-promotable-image.mjs",
    "image:prove": "node scripts/release/prove-promotable-image.mjs",
    "release:bind-production-image": "node scripts/release/bind-production-image.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@supabase/ssr": "0.12.4",
    "@supabase/supabase-js": "2.112.0",
    "lucide-react": "1.48.0",
    "next": "16.3.6",
    "parse5": "8.0.1",
    "postgres": "3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "0.35.5",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.0",
    "@types/node": "24.12.4",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "chrome-devtools-mcp": "1.10.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "next-devtools-mcp": "0.4.0",
    "prettier": "3.8.3",
    "prettier-plugin-tailwindcss": "0.6.14",
    "supabase": "2.115.0",
    "tailwindcss": "4.3.0",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
