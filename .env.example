# Variáveis de ambiente para descomplica-platform.
#
# Copie este arquivo para .env.local e preencha os valores reais.
# NUNCA comite .env.local — ele está no .gitignore.
# NUNCA insira valores reais neste arquivo — apenas nomes com placeholders vazios.

# ---------------------------------------------------------------------------
# Supabase
# Valores reais disponíveis no Supabase Dashboard após criação do projeto.
# Preencha APENAS em .env.local (gitignored). Nunca aqui.
# ---------------------------------------------------------------------------

# URL da API Supabase lida pelo servidor em runtime. O browser não recebe
# configuração via NEXT_PUBLIC_*; clientes browser futuros devem receber a
# dupla pública explicitamente por um Server Component.
SUPABASE_URL=

# Publishable key pública do Supabase (exposta ao client e ao server).
# Permite acesso controlado por grants e RLS. Nunca use secret/service_role aqui.
SUPABASE_PUBLISHABLE_KEY=

# ---------------------------------------------------------------------------
# Master Developer bootstrap (M5.4)
# UUID do usuário (auth.users.id) a ser promovido a role `master` UMA vez.
# NÃO é usado pelo app em runtime — serve apenas ao runbook de bootstrap
# executado manualmente via conexão privilegiada/psql.
# Ver docs/runbooks/bootstrap-master.md. Preencha só em .env.local.
# NUNCA comite o valor real. O SUPABASE_SERVICE_ROLE_KEY NÃO entra aqui
# nem no bundle do app — o bootstrap usa a conexão `postgres` diretamente.
# ---------------------------------------------------------------------------
MASTER_USER_ID=

# ---------------------------------------------------------------------------
# Integração Salesforce (somente servidor)
# Estes valores pertencem exclusivamente ao runtime Next.js. Nunca use o
# prefixo NEXT_PUBLIC_ e nunca os exponha ao navegador. Em desenvolvimento,
# use as credenciais emitidas pelo Supabase local; em ambientes remotos,
# crie/rotacione segredos próprios por ambiente.
# ---------------------------------------------------------------------------

# Origem canônica usada para validar POSTs autenticados do navegador.
APP_ORIGIN=http://127.0.0.1:3000

# HMAC server-only (mínimo 32 bytes) que protege a preferência absoluta de
# sessão lembrada. Ausente ou inválido faz fail-closed para cookie de sessão.
AUTH_SESSION_COOKIE_SECRET=

# Containers usam secret mount, nunca valor direto no environment. No host,
# aponta para arquivo root-only; dentro do container o Compose monta em
# /run/secrets/auth_session_cookie_secret.
AUTH_SESSION_COOKIE_SECRET_SOURCE=

# Ambiente regular por padrão. A homologação isolada usa true somente no seu
# build/runtime e desliga cadastro público de forma independente.
HOMOLOGATION_MODE=false
PUBLIC_SIGNUP_ENABLED=true

# As capacidades são independentes e ficam desativadas salvo valor exato `true`.
SALESFORCE_INGEST_ENABLED=false
SALESFORCE_REFRESH_ENABLED=false

# Read model v3: shadow local somente. Manter false até reconciliação, fonte
# canônica e cutover de permissões serem aprovados em etapa separada.
CRM_READ_MODEL_V3_SHADOW_ENABLED=false

# Relay Qlik autenticado (somente servidor). Permanece fail-closed enquanto
# QLIK_RELAY_MODE=off. Shadow compara sem escrever fatos; canary/active também
# exigem QLIK_RELAY_WRITE_ENABLED=true e um gate aprovado no banco.
QLIK_RELAY_MODE=off
QLIK_RELAY_WRITE_ENABLED=false
QLIK_RELAY_KEY_ID=
QLIK_RELAY_HMAC_SECRET=
# Conexão PostgreSQL exclusiva do papel crm_qlik_relay; nunca reutilize postgres,
# service_role ou a conexão administrativa.
QLIK_RELAY_DATABASE_URL=

# CLI de reconciliação de mappings. O token deve pertencer a uma sessão Master
# dedicada e nunca é aceito como argumento de linha de comando.
CRM_MAPPING_IMPORT_ACCESS_TOKEN=
CRM_MAPPING_IMPORT_APPLY_ENABLED=false

# Runtime de políticas comerciais (somente servidor). Este incremento aceita
# apenas off/shadow/active, mas permanece off e sem allowlist por padrão. Uma
# policy aprovada, seus casos de ouro e o gate no banco também são obrigatórios.
COMMERCIAL_ENGINE_RUNTIME_MODE=off
COMMERCIAL_ENGINE_ENABLED_KEYS=
# Conexão PostgreSQL direta/pooler do papel dedicado crm_commercial_engine.
# Deve pertencer ao mesmo project ref de SUPABASE_URL. Sem
# credencial provisionada neste incremento; nunca use service_role aqui.
COMMERCIAL_ENGINE_DATABASE_URL=

# Obrigatórios somente quando SALESFORCE_INGEST_ENABLED=true.
# Secret key Supabase usada exclusivamente pelo Route Handler M2M de ingestão.
SUPABASE_SECRET_KEY=
# Bearer com no mínimo 32 caracteres recebido do produtor de snapshots.
SALESFORCE_INGEST_SECRET=

# Obrigatórios somente quando SALESFORCE_REFRESH_ENABLED=true.
# Webhook HTTPS que inicia a extração no Salesforce e seu Bearer dedicado.
SALESFORCE_REFRESH_URL=
SALESFORCE_REFRESH_SECRET=
